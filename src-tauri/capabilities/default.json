{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "core:window:allow-destroy",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "tel:*" }, { "url": "mailto:*" }, { "url": "https://*" }]
    }
  ]
}
