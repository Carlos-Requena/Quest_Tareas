{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quests",
  "version": "0.1.0",
  "identifier": "com.quests.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quests",
        "width": 1280,
        "height": 780,
        "minWidth": 1024,
        "minHeight": 680,
        "theme": "Dark",
        "backgroundColor": "#0b0a09",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}